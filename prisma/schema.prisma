// CommunityPulse data model.
// Unlike LedgerLite (private financial data) and OpsConsole (internal
// privilege), almost everything here is intentionally public. That
// changes what "security" means: it is not about keeping data secret,
// it is about integrity (only the real author can edit or delete their
// own content) and availability (this data is exactly what an attacker
// would try to spam, scrape, or flood).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id // Clerk user id
  username  String   @unique
  bio       String?
  createdAt DateTime @default(now())

  threads  Thread[]
  comments Comment[]
}

model Thread {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  topic     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]

  @@index([authorId])
  @@index([topic])
}

model Comment {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([authorId])
}
